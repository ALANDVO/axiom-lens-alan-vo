# Axiom Lens - Environment Configuration Example
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME="Axiom Lens"
APP_VERSION=1.0.0

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./axiom_lens.db

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/axiom-lens
OIDC_CLIENT_ID=axiom-lens
OIDC_CLIENT_SECRET=axiom-lens-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES=openid profile email

# Demo Mode (localhost only, refuses in production)
DEMO_MODE=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM (Optional, opt-in)
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Keycloak Admin (for Docker Compose)
KEYCLOAK_ADMIN_PASSWORD=admin